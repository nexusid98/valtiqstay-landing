NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only (signed document upload URLs). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional override for the demo staff password used by scripts/seed-staff.ts
STAFF_DEMO_PASSWORD=
# Stripe — server-side billing (M5). Leave empty until the owner connects their
# own Stripe and saves the real keys in business Secrets. Billing API routes
# return "billing_not_configured" while either is missing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe Price id for the flat SaaS subscription (default empty until
# the real price is created in M5-3). Empty falls back to "no price configured".
STRIPE_SUBSCRIPTION_PRICE_ID=
